# Track Markdown at the root, plus the example apps in full.
*
!*/
!*.md
!.gitignore
!LICENSE

# Agent skills — tracked, drivers included.
!/.claude/skills/**

# Example apps — fully tracked.
!/feeds/**
!/iconbrowser/**
!/launcher/**
!/mindchat/**
!/sitedocs/**
!/themer/**
!/todos/**
!/vaultview/**

# ...except their compiled binaries.
/feeds/feeds
/iconbrowser/iconbrowser
/launcher/launcher
/mindchat/mindchat
/sitedocs/sitedocs
/themer/themer
/todos/todos
/vaultview/vaultview
