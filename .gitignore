# Track Markdown at the root, plus the root module and the apps in full.
*
!*/
!*.md
!.gitignore
!LICENSE

# The root module. Everything at the root is ignored by default, so its own
# files have to be named here or they are silently untracked.
!/go.mod
!/go.sum
!/*.go

# Agent skills — tracked, drivers included.
!/.claude/skills/**

# Example apps — fully tracked.
!/feeds/**
!/iconbrowser/**
!/launcher/**
!/mindchat/**
!/sitedocs/**
!/themer/**
!/todos/**
!/vaultview/**

# ...except their compiled binaries.
/feeds/feeds
/iconbrowser/iconbrowser
/launcher/launcher
/mindchat/mindchat
/sitedocs/sitedocs
/themer/themer
/todos/todos
/vaultview/vaultview
